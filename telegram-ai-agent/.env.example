# Telegram-Bot-Token von @BotFather (Pflicht)
TELEGRAM_BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic API-Key von https://platform.claude.com (Pflicht)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Nur diese Telegram-User-IDs duerfen den Bot benutzen (Komma-getrennt).
# Deine eigene ID bekommst du z.B. von @userinfobot in Telegram.
# Leer lassen = jeder darf den Bot benutzen (nicht empfohlen!)
ALLOWED_USER_IDS=

# Zeitzone fuer Termine und Erinnerungen
TIMEZONE=Europe/Berlin

# Pfad zur SQLite-Datenbank
DATABASE_PATH=assistant.db

# --- Optionale Funktionen ---------------------------------------------

# Sprachnachrichten: OpenAI API-Key fuer Whisper-Transkription
# (leer lassen = Sprachnachrichten deaktiviert)
OPENAI_API_KEY=

# Google-Kalender-Sync: einmalig autorisieren mit `python gcal_auth.py`
GOOGLE_CLIENT_SECRET_FILE=google_client_secret.json
GOOGLE_TOKEN_FILE=google_token.json
GOOGLE_CALENDAR_ID=primary

# Taegliche Morgen-Zusammenfassung (Termine + Aufgaben) im Format HH:MM.
# Leer lassen = deaktiviert.
MORNING_SUMMARY_TIME=07:00
